# .gitignore
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/

# PyTorch model weights (dvc-tracked thay vì git)
models/*.pt
models/*.pth
models/*.bin
# Nhưng commit file .dvc và .classes.txt
!models/*.dvc
!models/*.classes.txt

# Dataset thật (dvc-tracked)
data/raw/
data/low_confidence/
# Commit các file .dvc
!data/*.dvc

# DVC internal
.dvc/tmp/
.dvc/cache/

# IDE / OS
.idea/
.vscode/
*.DS_Store
*.swp
.env
.env.*

# pytest
.pytest_cache/
.coverage
htmlcov/
